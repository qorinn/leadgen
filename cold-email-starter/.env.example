# Masold at .env-re:  cp .env.example .env
# A .env-et SOHA ne commitold. (A .gitignore mar kizarja.)

# ─── Kuldo postafiokok ─────────────────────────────────────────────────────
# Formatum: cim:jelszo, vesszovel elvalasztva. Tobb fiok = rotacio.
# Google/Microsoft eseten NE a fiokjelszot hasznald, hanem alkalmazas-jelszot.
SMTP_ACCOUNTS=user1@sajatdomain.hu:APP_JELSZO_1,user2@sajatdomain.hu:APP_JELSZO_2

SMTP_HOST=smtp.szolgaltatod.hu
SMTP_PORT=465
SMTP_USE_SSL=true

IMAP_HOST=imap.szolgaltatod.hu
IMAP_PORT=993

FROM_NAME=Teljes Neved
REPLY_TO=valasz@sajatdomain.hu

# ─── Volumen ───────────────────────────────────────────────────────────────
# FONTOS: uj domainnel kezdj 20 korul. A rendszer magatol emeli, ha tiszta.
DAILY_CAP_START=20
DAILY_CAP_CEILING=200
RAMP_STEP=20
RAMP_STEP_DAYS=3

# ─── Idozites ──────────────────────────────────────────────────────────────
SEND_WINDOW_START=8
SEND_WINDOW_END=17
SEND_ON_WEEKEND=false
MIN_DELAY_SECS=25
MAX_DELAY_SECS=90

# ─── Follow-up letra (napok az EREDETI level ota) ──────────────────────────
FU1_DELAY_DAYS=5
FU2_DELAY_DAYS=10

# ─── Riasztasi kuszobok ────────────────────────────────────────────────────
REJECT_RATE_ALERT=0.03
BOUNCE_RATE_ALERT=0.04
