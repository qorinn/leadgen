# A scraper (leadgen) kornyezeti valtozoi.
#   cp .env.example .env
# A .env-et a .gitignore kizarja. IDE JONNEK A KULCSOK, sehova mashova.
#
# FIGYELEM: ez NEM a kuldo rendszer .env-je. Az kulon fajl:
#   cold-email-starter/.env   (SMTP/IMAP adatok, postafiok-jelszavak)

# ─── Supabase / Postgres ───────────────────────────────────────────────────
# Supabase -> Project Settings -> Database -> Connection string
#           -> "Session pooler" ful -> URI
# A stringben benne van az adatbazis-jelszo. Soha ne masold chatbe vagy kodba.
DATABASE_URL=

# Csak a kesobbi webes felulethez (13. szakasz). Most hagyd uresen.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── A kuldo rendszer helye (export + feedback import) ─────────────────────
SENDER_DIR=./cold-email-starter

# ─── Email validacio (B) dontes) ───────────────────────────────────────────
# off | local_only | full     -- indulaskor: local_only
EMAIL_VALIDATION=local_only
REOON_API_KEY=

# ─── AI (a 6. szakasztol kell) ─────────────────────────────────────────────
# A modellneveket a bake-off eredmenye irja felul.
# A PROVIDER A MODELLNEVBOL derul ki -- providert valtani = EZT AZ EGY SORT
# atirni. Nincs kulon kapcsolo, es a hivo kod nem valtozik.
#   gpt-* / o1 / o3 / o4  -> OpenAI      claude-* -> Anthropic
#   gemini*               -> Google
LLM_BULK_MODEL=gpt-5.6-luna
LLM_QUALITY_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
# A Gemini-integracio megmaradt: ha visszaallnal, allitsd at a
# LLM_BULK_MODEL-t es toltsd ki ezt a sort.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Forrasok (a 9. szakasztol kell) ───────────────────────────────────────
APIFY_TOKEN=